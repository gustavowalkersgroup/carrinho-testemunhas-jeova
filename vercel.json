{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "app/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index?__original_path=/$1" }
  ],
  "crons": [
    { "path": "/api/automacao/resetar-demo", "schedule": "0 4 * * *" }
  ]
}
