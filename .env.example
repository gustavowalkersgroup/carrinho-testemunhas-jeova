# Variáveis do modo WEB (hospedado). Copie os nomes para as Environment
# Variables do projeto na Vercel — este arquivo é só referência, nunca coloque
# valores reais aqui nem no Git.
#
# O app de desktop não usa NENHUMA destas: sem DATABASE_URL ele roda em modo
# local, com SQLite ao lado do executável, exatamente como antes.

# --- obrigatórias -----------------------------------------------------------

# Postgres. Na Vercel, criar um banco em Storage > Neon já injeta esta variável
# automaticamente. Use a string de conexão COM POOLER (o host tem "-pooler"):
# cada request serverless abre uma conexão, e sem pooler o banco esgota.
DATABASE_URL=postgresql://usuario:senha@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Quem administra a instalação inteira: aprova solicitações, cria congregações
# e promove outros administradores. É o único jeito de a instalação ganhar o
# primeiro administrador. Aceita vários e-mails separados por vírgula.
SUPER_ADMIN_EMAIL=voce@exemplo.com

# Assina os cookies de sessão. Gere um valor aleatório longo e NÃO mude depois:
# trocar derruba todas as sessões abertas.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# --- automação (opcional) ---------------------------------------------------
# Autentica integrações externas (n8n, scripts) na API em /api/automacao/*,
# que não usa login por e-mail. Sem valor definido, essa API fica desligada.
#   python -c "import secrets; print(secrets.token_hex(32))"
# AUTOMACAO_API_KEY=troque-por-um-valor-aleatorio-longo

# --- envio de e-mail --------------------------------------------------------
# Sem um destes, só o SUPER_ADMIN_EMAIL consegue entrar (o código de acesso sai
# no log da função, visível no painel da Vercel). Configure antes de liberar
# acesso a outras pessoas.

# Opção A — Resend (recomendado: é HTTP, funciona bem em serverless)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Enquanto não houver domínio próprio verificado, o remetente de testes do
# Resend funciona — mas só entrega no e-mail dono da conta Resend.
EMAIL_FROM=Escala do Carrinho <onboarding@resend.dev>

# Opção B — SMTP próprio (deixe RESEND_API_KEY vazio para usar este)
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=escala@seudominio.com
# SMTP_PASSWORD=

# --- opcionais --------------------------------------------------------------

# Endereço público, usado nos links dentro dos e-mails. Na Vercel é deduzido
# automaticamente; preencha só se usar domínio próprio.
# APP_BASE_URL=https://escala.seudominio.com

# Só para testar o modo WEB em http://localhost (cookie sem HTTPS).
# COOKIE_SEGURO=0

# Usado apenas por `pytest tests_web` (suíte do modo hospedado).
# DATABASE_URL_TESTE=postgresql://postgres@localhost:5432/escala_test
